{
  "outputStyle": "CyberRiskGuardian Analyst",
  "env": {
    "CRG_DEFAULT_APPETITE": "0.30",
    "CRG_FACTOR": "1000",
    "CRG_HORIZON_MONTHS": "12",
    "CRG_CVSS_VERSION": "4.0",
    "CRG_CVSS_SCOPE": "base-only",
    "CRG_SNAPSHOT_MAX_AGE_DAYS": "90",
    "CRG_THREAT_REGIONS": "ca,intl"
  },
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(bash scripts/*)",
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.md\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_labels.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_labels.py\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
