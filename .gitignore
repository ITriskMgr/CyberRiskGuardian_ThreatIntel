# private preferences and local overrides
CLAUDE.local.md
.claude/settings.local.json

# generated client deliverables and organization data
/out/
/deliverables/
*.client.json
*.client.xlsx

# large generated snapshots other than the shipped one. Anchored to the plugin's own examples/
# folder: without the leading slash this also matched desktop/examples/threat-context/, which would
# have dropped the example snapshot the desktop package ships and broken it silently.
/examples/threat-context/*.json
!/examples/threat-context/threat-context-shipped.json

# python / node
__pycache__/
*.pyc
.venv/
node_modules/

# macOS, editor and tooling junk
.DS_Store
._*
.Spotlight-V100
.Trashes
.Rhistory
.Rapp.history
.RData
Thumbs.db
*.swp
*~

# office and libreoffice artifacts
~$*
.~lock.*

# working folder of the desktop sessions: downloaded feeds, briefings and crg-keys.json (API keys).
# Never committed. If you keep it elsewhere, ignore that path here too.
/Claude outputs/
crg-keys.json

# CyberRiskGuardian Ontology (CRGO) clones kept inside the repository folder, e.g.
# CyberRiskGuardian-Ontology-0.10.0/ (pinned tag v0.10.0), or a symlink to a checkout elsewhere.
# Separate repository and licence; never committed.
CyberRiskGuardian-Ontology*/
/CyberRiskGuardian-Ontology*

# generated organisation graphs, risk contexts, compliance/secops reads and dss/v1 write-backs (crgo_contract.py writes to output/crgo/).
# They are client data: keep them with the confidential deliverables, never in this repository.
/output/

# licensed standards downloaded for local reference (CRGO-downloads/); never redistributed.
/CRGO-downloads/

# the desktop app's pointer to this computer's feeds folder (a local path).
desktop/app/feeds-dir.txt
